<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Camera Body with subtle shadow / glow -->
    <path
        android:pathData="M34,36 L62,36 A8,8 0 0 1 70,44 L70,64 A8,8 0 0 1 62,72 L34,72 A8,8 0 0 1 26,64 L26,44 A8,8 0 0 1 34,36 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="26"
                android:startY="36"
                android:endX="70"
                android:endY="72"
                android:type="linear">
                <item android:offset="0" android:color="#8B5CF6" />
                <item android:offset="1" android:color="#06B6D4" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Camera Lens / Projector Cone -->
    <path
        android:pathData="M70,47 L82,39 A3,3 0 0 1 86,41.5 L86,66.5 A3,3 0 0 1 82,69 L70,61 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="70"
                android:startY="47"
                android:endX="86"
                android:endY="69"
                android:type="linear">
                <item android:offset="0" android:color="#7C3AED" />
                <item android:offset="1" android:color="#38BDF8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Camera Lens Aperture Ring -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:strokeAlpha="0.9"
        android:pathData="M48,54m-8,0a8,8 0,1 1,16 0a8,8 0,1 1,-16 0" />

    <!-- Lens Glass Center -->
    <path
        android:fillColor="#0F172A"
        android:pathData="M48,54m-5,0a5,5 0,1 1,10 0a5,5 0,1 1,-10 0" />

    <!-- Live Recording / Active Signal Dot -->
    <path
        android:fillColor="#10B981"
        android:pathData="M34,43m-2.5,0a2.5,2.5 0,1 1,5 0a2.5,2.5 0,1 1,-5 0" />

</vector>
